<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">

    <VBox layoutX="41.0" layoutY="28.0" spacing="10">

        <!-- Title -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Secure Password Manager" />

        <!-- Add New Password -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Add New Password" />
            <TextField fx:id="siteField" promptText="Enter Website/App Name" />
            <TextField fx:id="usernameField" promptText="Enter Username" />
            <PasswordField fx:id="passwordField" promptText="Enter Password" />
            <Button fx:id="generatePasswordBtn" onAction="#generatePassword" text="Generate Password" />
            <Button onAction="#savePassword" text="Save Password" />
        </VBox>

        <Separator />

        <!-- Saved Passwords Section -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Saved Passwords" />
            <ListView fx:id="passwordList" />
            <Button onAction="#editSelectedPassword" text="Edit Selected" />
            <Button onAction="#deleteSelectedPassword" text="Delete Selected" />
            <Button onAction="#loadSavedPasswords" text="Refresh" />
        </VBox>

    </VBox>

      <TableView fx:id="passwordTable" layoutX="315.0" layoutY="287.0">
          <columns>
              <TableColumn fx:id="siteColumn" text="Website/App" />
              <TableColumn fx:id="usernameColumn" text="Username" />
              <TableColumn fx:id="passwordColumn" text="Password" />
          </columns>
      </TableView>
</AnchorPane>
