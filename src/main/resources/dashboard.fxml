<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">

    <VBox layoutX="20.0" layoutY="20.0" spacing="10">

        <!-- Title -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Secure Password Manager" />

        <!-- Add New Password -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Add New Password" />
            <TextField fx:id="siteField" promptText="Enter Website/App Name" />
            <TextField fx:id="usernameField" promptText="Enter Username" />
            <PasswordField fx:id="passwordField" promptText="Enter Password" />
            <Button fx:id="generatePasswordBtn" onAction="#generatePassword" text="Generate Password" />
            <Button fx:id="savePasswordBtn" onAction="#savePassword" text="Save Password" />
        </VBox>

        <Separator />

        <!-- Saved Passwords Table -->
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Saved Passwords" />
        <TableView fx:id="passwordTable" prefWidth="550">
            <columns>
                <TableColumn fx:id="siteColumn" text="Website/App" prefWidth="180"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180"/>
                <TableColumn fx:id="passwordColumn" text="Password" prefWidth="180"/>
            </columns>
        </TableView>

        <!-- Action Buttons -->
        <HBox spacing="10">
            <Button fx:id="editPasswordBtn" onAction="#editSelectedPassword" text="Edit Selected" />
            <Button fx:id="deletePasswordBtn" onAction="#deleteSelectedPassword" text="Delete Selected" />
            <Button fx:id="refreshBtn" onAction="#loadSavedPasswords" text="Refresh" />
        </HBox>

    </VBox>
</AnchorPane>
