<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.UIController">

    <VBox alignment="CENTER" layoutX="88.0" layoutY="127.0" prefWidth="424.0" spacing="10">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Login to Secure Password Manager" />

        <TextField fx:id="usernameField" promptText="Enter Username" />
        <PasswordField fx:id="passwordField" promptText="Enter Password" />
        <Button onAction="#handleLogin" text="Login" />

        <Label fx:id="statusLabel" textFill="red" />
        <Hyperlink onAction="#switchToRegister" text="Don't have an account? Register" />
        <Button onAction="#switchToRegister" text="Register" />

    </VBox>
</AnchorPane>
