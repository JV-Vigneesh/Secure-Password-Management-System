<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="375.0" prefWidth="398.0" spacing="10" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.UIController">
    <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="55.0" prefWidth="62.0" text="Login">
      <font>
         <Font size="16.0" />
      </font></Label>
    <TextField fx:id="usernameField" prefHeight="26.0" prefWidth="257.0" promptText="Username">
      <VBox.margin>
         <Insets left="20.0" right="20.0" />
      </VBox.margin></TextField>
    <PasswordField fx:id="passwordField" prefHeight="0.0" prefWidth="398.0" promptText="Password">
      <VBox.margin>
         <Insets left="20.0" right="20.0" />
      </VBox.margin></PasswordField>
    <Button fx:id="loginButton" layoutX="10.0" layoutY="10.0" onAction="#handleLogin" text="Login" />
    <Button onAction="#handleRegister" text="Register" />
</VBox>
